SESSION_COOKIE_SAMESITE=none
SESSION_COOKIE_SECURE=false

# --- DB: Supabase Postgres (pooled) ---
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# --- Supabase Project URL ---
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_JWKS_URL=https://YOUR_PROJECT_ID.supabase.co/auth/v1/keys

# --- Supabase Auth JWT Secret (Project Settings → API → JWT Secret) ---
SUPABASE_JWT_SECRET=your_jwt_secret_here

# --- CORS: frontend origin ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Google OAuth (optional) ---
#GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=your_google_client_secret
#OAUTH_REDIRECT_URL=http://localhost:8000/auth/google/callback